# ===========================================
# GUIDE - ENVIRONMENT VARIABLES
# ===========================================
# Copy to .env for local development.

# -----------------
# Application
# -----------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=1

# -----------------
# AI Providers (at least one key REQUIRED)
# -----------------
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------
# Database / Caching
# -----------------
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://guide:guide123@localhost:5432/guide

# -----------------
# Frontend Demo
# -----------------
# Set to true to run the frontend with static mock data
NEXT_PUBLIC_GUIDE_DEMO_MODE=true
